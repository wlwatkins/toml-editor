// Example configuration file.
// The second line of the file-level comment block.
{
  // The name reported in logs and metrics.
  "title": "JSON Editor Demo",
  "enabled": true,
  // Millisecond budget for a single request.
  "timeout_ms": 2500,
  "ratio": 0.75,
  "retries": null,

  // Connection details for the HTTP listener.
  "server": {
    "host": "127.0.0.1", // bind address
    "port": 8080,
    // Ports the health checker also probes.
    "extra_ports": [8081, 8082, 8083],
    "tls": false,
    "limits": {
      // Maximum concurrent in-flight requests.
      "max_connections": 512,
      "max_body_bytes": 10485760
    }
  },

  // Where structured logs are written.
  "logging": {
    "level": "info",
    "format": "json",
    "sinks": [
      "stdout",
      "file"
    ]
  },

  "database": {
    "url": "postgres://localhost:5432/app",
    "pool": { "min": 2, "max": 16 },
    "replicas": ["replica-a", "replica-b"]
  },

  // Each product below becomes a record in the list.
  "products": [
    { "name": "Hammer", "sku": 738594937, "in_stock": true },
    { "name": "Nail", "sku": 284758393, "in_stock": false }
  ]
}
